# Data (never commit raw medical imaging data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model outputs
outputs/checkpoints/*
outputs/predictions/*
!outputs/checkpoints/.gitkeep
!outputs/predictions/.gitkeep

# Credentials - NEVER commit these
kaggle.json
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# OS
.DS_Store

# Jupyter
*.log
